{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gigpredictor.local/schemas/booking-request.schema.json",
  "title": "GigPredictorBookingRequest",
  "type": "object",
  "required": ["lat", "lng", "radius", "dates", "budget"],
  "properties": {
    "lat": { "type": "number" },
    "lng": { "type": "number" },
    "radius": { "type": "number", "minimum": 1 },
    "dates": {
      "type": "array",
      "items": { "type": "string", "format": "date" },
      "minItems": 1
    },
    "budget": { "type": "number", "minimum": 0 }
  }
}
